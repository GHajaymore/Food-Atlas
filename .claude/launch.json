{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wikifoodia-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "wikifoodia-functions",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        "dist",
        "--port",
        "8788",
        "--local"
      ],
      "port": 8788
    }
  ]
}
