# Cloudflare Pages reads this file at deploy time and does not serve it.
#
# It is the Cloudflare counterpart of the `headers` block in vercel.json; the two
# must be kept saying the same thing, because the project can deploy to either.

# Metro fingerprints these filenames, so the content behind a given URL can never
# change. Cache them for a year and never revalidate.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The catalogue used to be the opposite case: content that changes whenever an ingest
# runs, behind filenames that never do. It was served `max-age=3600,
# stale-while-revalidate=604800` with a note saying an ingest "reaches everybody within
# the hour".
#
# It did not. Stale-while-revalidate serves the **old** copy to the first visit after the
# hour and fetches the new one behind it, so a correction lands one visit late — and a
# reader who visits once a week is never shown anything newer than a week. The day after
# 37 records stopped being labelled "Authentic", Ajay was still shown a dish scored 29 and
# called authenticated. The atlas was right and his browser was a week behind.
#
# The app now asks for `/data/x.json?v=<hash of the data>` (scripts/stamp-data-version.mjs),
# so corrected data has an address no cache has ever seen and arrives on the next visit.
# That is what makes `immutable` correct here rather than tempting: the address names the
# contents, so the copy behind it really can never change.
#
# An unversioned `/data/x.json` — typed by hand, or fetched by a script — is cached under
# its own address and can go stale for a year. Nothing the app does asks for one.
/data/*
  Cache-Control: public, max-age=31536000, immutable

# Applied to everything, including the JSON above.
/*
  # The atlas renders text and links that came from open wikis, so a MIME sniff
  # turning a response into something executable is a real risk rather than a
  # theoretical one. Same reasoning as the scheme allowlist in src/domain/video.ts.
  X-Content-Type-Options: nosniff

  # Nothing here should be framed by another site.
  X-Frame-Options: SAMEORIGIN

  # Source links leave for Wikipedia, Wikidata and YouTube. Send the origin, never
  # the full path — which dish somebody was reading is their business.
  Referrer-Policy: strict-origin-when-cross-origin

  # The front page states that the app does not track anybody, and scripts/ingest-timezones.mjs
  # explains why location comes from the timezone rather than from geolocation.
  # This makes that claim enforceable by the browser instead of merely true today:
  # the permission cannot be requested at all, by our code or anybody else's.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
